{
  "name": "waker",
  "version": "2.0.0",
  "private": true,
  "description": "WorkerHub 全舰队统一调度平台：1 个 watchdog Cron + Durable Object Alarm + Queue",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:web && wrangler dev",
    "dev:web": "pnpm --filter @waker/web dev",
    "build:web": "pnpm --filter @waker/web build",
    "deploy": "pnpm build:web && wrangler deploy",
    "build": "pnpm build:web && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && pnpm --filter @waker/web typecheck",
    "lint": "eslint . && pnpm --filter @waker/web lint",
    "test": "pnpm build:web && vitest run && pnpm --filter @waker/web test",
    "test:watch": "vitest",
    "check:cron": "node scripts/check-single-cron.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:cron && pnpm test && pnpm build"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "croner": "^10.0.1",
    "hono": "^4.13.14",
    "otpauth": "^9.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "miniflare": "5.20261019.2-beta",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
